@page "/Chat"
@using System.IdentityModel.Tokens.Jwt
@using Blazored.LocalStorage
@using FvckAds.Client.Application.WebClient.Authentications.Commands
@using FvckAds.SimpleWeb.Components.Models
@using MediatR
@using Microsoft.AspNetCore.SignalR.Client
@rendermode InteractiveServer

<aside class="sidebar">
    <div class="sidebar-content">
        <div class="add-item-box">
            <button class="add-item-btn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Add New Chat
            </button>
        </div>

        <!-- Example Chat Items -->
        <div class="chat-items">
            <!-- Chat Item 1 -->
            @foreach (var room in _rooms)
            {
                <div class="chat-item">
                    <div class="chat-item-header">
                        <span class="chat-item-name">@room.Name</span>
                        <span class="chat-item-count">@room.ThreadNames.Count</span>
                    </div>
                    <ul class="chat-item-list">
                        @foreach (var threadItem in room.ThreadNames)
                        {
                            <li>@threadItem</li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
</aside>
<main class="main-chat-area">
    <div class="chat-container">
        <!-- Main Chat Messages -->
        <div class="chat-messages">
            <!-- Thread Group 1 -->
            @foreach (var thread in _messages)
            {
                <div class="thread-group" @onclick="() => SetCurrentThread(thread.Id)">
                    <input type="hidden" name="threadId" id="currentThreadId" value="@thread.Id">
                    <div class="message incoming thread-starter">
                        <div class="message-avatar">J</div>
                        <div class="message-wrapper">
                            <div class="message-content">
                                <div class="message-header">
                                    <span class="message-author">
                                        @if (!string.IsNullOrEmpty(thread.ThreadName))
                                        {
                                            @thread.ThreadName
                                        }
                                        @if (string.IsNullOrEmpty(thread.ThreadName))
                                        {
                                            <div>Default Thread</div>
                                        }
                                    </span>
                                    <span class="message-time">10:30 AM</span>
                                </div>
                                @if (!string.IsNullOrEmpty(thread.Description))
                                {
                                    @thread.Description
                                }
                            </div>
                            <div class="thread-info">
                                <button class="thread-reply-btn">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="2">
                                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                                    </svg>
                                    @thread.Messages.Count replies
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="thread-replies">
                        <div class="message outgoing thread-reply">
                            <div class="message-wrapper">
                                @foreach (var message in thread.Messages)
                                {
                                    <div class="message-content">
                                        <div class="message-header">
                                            <span class="message-author">
                                                @if (message.IsCurrent)
                                                {
                                                    <div>You</div>
                                                }
                                                @if (!message.IsCurrent)
                                                {
                                                    @message.Tag
                                                }
                                            </span>
                                            <span class="message-time">10:35 AM</span>
                                        </div>
                                        @message.Text
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
            @* <div class="thread-group"> *@
            @*     <!-- Original Message --> *@
            @*     <div class="message incoming thread-starter"> *@
            @*         <div class="message-avatar">J</div> *@
            @*         <div class="message-wrapper"> *@
            @*             <div class="message-content"> *@
            @*                 <div class="message-header"> *@
            @*                     <span class="message-author">John Doe</span> *@
            @*                     <span class="message-time">10:30 AM</span> *@
            @*                 </div> *@
            @*                 Project Timeline Discussion *@
            @*             </div> *@
            @*             <div class="thread-info"> *@
            @*                 <button class="thread-reply-btn"> *@
            @*                     <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"> *@
            @*                         <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path> *@
            @*                     </svg> *@
            @*                     3 replies *@
            @*                 </button> *@
            @*             </div> *@
            @*         </div> *@
            @*     </div> *@
            @* *@
            @*     <!-- Thread Replies (Collapsed by default) --> *@
            @*     <div class="thread-replies"> *@
            @*         <div class="message outgoing thread-reply"> *@
            @*             <div class="message-wrapper"> *@
            @*                 <div class="message-content"> *@
            @*                     <div class="message-header"> *@
            @*                         <span class="message-author">You</span> *@
            @*                         <span class="message-time">10:35 AM</span> *@
            @*                     </div> *@
