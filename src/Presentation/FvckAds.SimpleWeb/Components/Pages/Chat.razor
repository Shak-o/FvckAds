@page "/Chat"
@using Blazored.LocalStorage
@inject ILogger<Chat> _logger;
@rendermode InteractiveServer

<main class="main-chat-area">
    <div class="placeholder-content">
        <div class="chat-container">
            <div class="chat-messages">
                <!-- Incoming message example -->
                <div class="message incoming">
                    <div class="message-avatar">J</div>
                    <div>
                        <div class="message-content">
                            Hey! How are you doing?
                        </div>
                        <div class="message-time">10:30 AM</div>
                    </div>
                </div>

                <!-- Outgoing message example -->
                <div class="message outgoing">
                    <div>
                        <div class="message-content">
                            I'm doing great, thanks for asking! How about you?
                        </div>
                        <div class="message-time">10:31 AM</div>
                    </div>
                </div>
            </div>

            <div class="chat-input-container">
                <div class="chat-input-wrapper">
            <textarea class="chat-input"
                      placeholder="Type a message..."
                      rows="1"></textarea>
                    <button class="send-button">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="22" y1="2" x2="11" y2="13"></line>
                            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </div>
</main>

@if (IsVisible)
{
    <div class="api-modal-overlay">
        <div class="api-modal">
            <h2 class="api-modal-title">Enter API Key</h2>
            <p class="api-modal-description">Please enter your API key to access the chat</p>
            
            <div class="api-input-group">
                <input type="password" 
                       class="api-key-input" 
                       placeholder="Enter your API key"
                       @bind="ApiKey"
                       @bind:event="oninput"
                       @onkeypress="HandleKeyPress" />
                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <small class="api-key-error">@ErrorMessage</small>
                }
                <small class="api-key-hint">Your API key will be securely stored</small>
            </div>

            <button class="api-submit-btn" @onclick="HandleSubmit">
                Continue to Chat
            </button>
        </div>
    </div>
}

